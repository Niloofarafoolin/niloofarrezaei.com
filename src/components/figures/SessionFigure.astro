---
/**
 * IISE 2025 feasibility study: what was recorded, and when, in one session.
 *
 * Every statement comes from the published paper. The wave is one fixed, even pattern that
 * marks when the wearables record. It is not study data and it carries no trend.
 * The only result shown is completion time, and only its direction: see the wording note
 * in src/data/projects.ts.
 *
 * The scene is drawn here, in a shallow three-quarter view, from boxes placed in space:
 * x runs along the line, y runs away from the viewer, z runs up.
 */
import XFigure from './XFigure.astro';

const id = 'fig-session';

const atStation = ['Wearable signals', 'Completion time', 'Errors', 'Self-report after'];

const parts = [
  {
    name: 'Baseline',
    short: 'Rest',
    sub: 'Resting signals',
    title: 'Baseline',
    text: 'A short rest before assembly begins. The wearables record resting signals to compare against.',
    recorded: ['Wearable signals'],
  },
  {
    name: 'Station 1',
    short: 'S1',
    sub: 'Low complexity',
    title: 'Station 1: low complexity',
    text: 'Basic component insertion and alignment.',
    recorded: atStation,
  },
  {
    name: 'Station 2',
    short: 'S2',
    sub: 'Medium complexity',
    title: 'Station 2: medium complexity',
    text: 'Multi-part coordination and handling several components.',
    recorded: atStation,
  },
  {
    name: 'Station 3',
    short: 'S3',
    sub: 'High complexity',
    title: 'Station 3: high complexity',
    text: 'Precision screwing and final assembly.',
    recorded: atStation,
  },
  {
    name: 'Wrap-up',
    short: 'End',
    sub: 'Survey and check',
    title: 'Wrap-up',
    text: 'A NASA-TLX workload survey, and a function check of the assembled tool that confirms errors.',
    recorded: ['NASA-TLX survey', 'Function check'],
  },
];

const isStation = (i: number) => i >= 1 && i <= 3;

// ---------- the scene ----------

const KX = 0.36;
const KY = 0.3;
const BASE = 226;
const ZONE = 200;
const f1 = (v: number) => v.toFixed(1);
/** A point in space, as a position on the page. */
const P = (x: number, y: number, z: number) => `${f1(x + y * KX)} ${f1(BASE - z - y * KY)}`;
const quad = (a: string, b: string, c: string, d: string) => `M${a}L${b}L${c}L${d}Z`;
const front = (x: number, y: number, z: number, w: number, h: number) =>
  quad(P(x, y, z), P(x + w, y, z), P(x + w, y, z + h), P(x, y, z + h));
const top = (x: number, y: number, z: number, w: number, d: number) =>
  quad(P(x, y, z), P(x + w, y, z), P(x + w, y + d, z), P(x, y + d, z));
const side = (x: number, y: number, z: number, d: number, h: number) =>
  quad(P(x, y, z), P(x, y + d, z), P(x, y + d, z + h), P(x, y, z + h));
/** A box with its three visible faces: side, top, front. */
const box = (mat: string, x: number, y: number, z: number, w: number, d: number, h: number) =>
  `<g class="ob ${mat}"><path class="s" d="${side(x + w, y, z, d, h)}"/><path class="t" d="${top(x, y, z + h, w, d)}"/><path class="f" d="${front(x, y, z, w, h)}"/></g>`;
const centre = (zone: number) => (zone - 0.5) * ZONE;

const shadow = (x: number, y: number, w: number, d: number) => `<path class="ses-shadow" d="${top(x - 3, y - 5, 0.1, w + 12, d + 12)}"/>`;

function station(zone: number) {
  const n = zone - 1;
  const cx = centre(zone);
  const x0 = cx - 66;
  const W = 132;
  const D = 44;
  const TOP = 76;
  let s = shadow(x0, 0, W, D);
  s += box('ob-frame', x0 + 3, D - 7, 0, 5, 5, TOP) + box('ob-frame', x0 + W - 8, D - 7, 0, 5, 5, TOP);
  s += box('ob-frame', x0 + 3, 2, 0, 5, 5, TOP) + box('ob-frame', x0 + W - 8, 2, 0, 5, 5, TOP);
  s += box('ob-bench', x0, 0, TOP, W, D, 6);
  s += box('ob-frame', x0 + 3, D - 7, TOP + 6, 5, 5, 72) + box('ob-frame', x0 + W - 8, D - 7, TOP + 6, 5, 5, 72);
  s += box('ob-frame', x0 + 3, D - 7, TOP + 78, W - 6, 5, 5);
  s += box('ob-screen', cx - 28, D - 10, TOP + 30, 56, 3, 36);
  s += `<path class="ses-glow" d="${front(cx - 25, D - 10, TOP + 33, 50, 30)}"/>`;
  for (let k = 0; k < 3; k++) {
    s += `<path class="ses-screenline" d="${front(cx - 20, D - 10, TOP + 54 - k * 8, 30 - k * 7, 2.6)}"/>`;
  }
  s += box('ob-bin', x0 + 10, D - 20, TOP + 6, 20, 10, 9) + box('ob-bin is-green', x0 + 33, D - 20, TOP + 6, 20, 10, 9);
  s += box('ob-plate', cx - 30, 7, TOP + 6, 14 + n * 15, 20, 2);
  for (let k = 0; k < n; k++) s += box('ob-part', cx - 27 + k * 15, 11, TOP + 8, 11, 11, 8 + k * 4);
  const px0 = cx + 26;
  let sheet = `<path class="ses-sheet" d="${top(px0, 8, TOP + 6.4, 30, 24)}"/>`;
  for (let k = 0; k < 4; k++) {
    sheet += `<path class="ses-sheetline" d="M${P(px0 + 5, 12 + k * 5, TOP + 6.6)}L${P(px0 + (k === 3 ? 15 : 25), 12 + k * 5, TOP + 6.6)}"/>`;
  }
  const tablet =
    box('ob-tablet', px0, 18, TOP + 6, 34, 3, 24) +
    `<path class="ses-tabglow" d="${front(px0 + 2.5, 18, TOP + 8.5, 29, 19)}"/>` +
    `<path class="ses-play" d="M${P(px0 + 13, 18, TOP + 13)}L${P(px0 + 13, 18, TOP + 23)}L${P(px0 + 22, 18, TOP + 18)}Z"/>`;
  s += `<g class="ses-medium" data-b="1">${sheet}</g><g class="ses-medium" data-b="2">${tablet}</g>`;
  return `<text class="ses-numeral" data-a="${zone}" x="${f1(cx + 64)}" y="96">${n}</text><g class="ses-zone" data-a="${zone}">${s}</g>`;
}

function chair() {
  const x = 106;
  const y = 6;
  let s = shadow(x, y, 36, 32);
  s += box('ob-frame', x + 2, y + 26, 0, 4, 4, 42) + box('ob-frame', x + 30, y + 26, 0, 4, 4, 42);
  s += box('ob-frame', x + 2, y + 2, 0, 4, 4, 42) + box('ob-frame', x + 30, y + 2, 0, 4, 4, 42);
  s += box('ob-seat', x, y, 42, 36, 32, 5);
  s += box('ob-seat', x, y + 28, 47, 36, 4, 40);
  return `<g class="ses-zone" data-a="1">${s}</g>`;
}

function desk() {
  const x = 852;
  const y = 2;
  const W = 112;
  const D = 40;
  const TOP = 66;
  let s = shadow(x, y, W, D);
  s += box('ob-frame', x + 3, y + D - 7, 0, 5, 5, TOP) + box('ob-frame', x + W - 8, y + D - 7, 0, 5, 5, TOP);
  s += box('ob-frame', x + 3, y + 2, 0, 5, 5, TOP) + box('ob-frame', x + W - 8, y + 2, 0, 5, 5, TOP);
  s += box('ob-bench', x, y, TOP, W, D, 5);
  s += box('ob-board', x + 12, y + 24, TOP + 5, 30, 3, 40);
  s += `<path class="ses-sheet" d="${front(x + 15, y + 24, TOP + 8, 24, 32)}"/>`;
  for (let k = 0; k < 4; k++) {
    s += `<path class="ses-tick" d="M${P(x + 18, y + 24, TOP + 33 - k * 7)}l2 2 3.4-4"/>`;
    s += `<path class="ses-sheetline" d="M${P(x + 26, y + 24, TOP + 33 - k * 7)}L${P(x + 36, y + 24, TOP + 33 - k * 7)}"/>`;
  }
  s += box('ob-tool', x + 56, y + 8, TOP + 5, 38, 14, 13) + box('ob-chuck', x + 94, y + 11, TOP + 8, 9, 8, 7);
  const [lx, ly] = P(x + 64, y + 8, TOP + 12).split(' ');
  s += `<circle class="ses-led xlive" cx="${lx}" cy="${ly}" r="2.6"/>`;
  return `<g class="ses-zone" data-a="5">${s}</g>`;
}

const floor = box('ob-floor', 14, -30, -10, 960, 100, 10);
const spot = `<path class="ses-spot" d="${top(24, -22, 0.2, 150, 78)}"/>`;
const scene = floor + spot + chair() + station(2) + station(3) + station(4) + desk();

// A fixed, even wave, cut into the parts of the session so each part can light up on its own.
const WAVE = { width: 200, height: 40 };
const waveFor = (cell: number) =>
  Array.from({ length: 51 }, (_, i) => {
    const x = (i / 50) * WAVE.width;
    const t = cell * WAVE.width + x;
    const y = WAVE.height / 2 + 8 * Math.sin(t * 0.085) + 3 * Math.sin(t * 0.26);
    return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }).join('');
---

<XFigure
  id={id}
  no={2}
  title="One session, three kinds of data"
  hint="Walk the operator through the session, then switch the instructions to see what changed."
>
  {
    parts.map((_, i) => (
      <input class="xin xin-a" type="radio" name={`${id}-a`} id={`${id}-a${i + 1}`} value={i + 1} checked={i === 1} />
    ))
  }
  <input class="xin xin-b" type="radio" name={`${id}-b`} id={`${id}-b1`} value="1" checked />
  <input class="xin xin-b" type="radio" name={`${id}-b`} id={`${id}-b2`} value="2" />

  <div class="xrow ses-formats">
    <span class="xlabel">Instructions at each station</span>
    <div class="xseg">
      <label class="xpick" for={`${id}-b1`} data-pick-b="1">Paper</label>
      <label class="xpick xnudge" for={`${id}-b2`} data-pick-b="2">Tablet video</label>
    </div>
  </div>

  <div class="xfig-stage ses">
    <div class="ses-view">
    <svg class="ses-scene" viewBox="0 14 1000 234" aria-hidden="true" focusable="false">
      <Fragment set:html={scene} />
      <g class="ses-op">
        <ellipse class="op-shadow" cx="3" cy="1" rx="17" ry="4.2"></ellipse>
        <path class="op-leg" d="M-8.5 -58L-9 -3Q-9 0-6 0H-1V-58Z"></path>
        <path class="op-leg" d="M1 -58V0H6Q9 0 9 -3L8.5 -58Z"></path>
        <path class="op-sleeve is-far" d="M-10 -105L-13.5 -86"></path>
        <path class="op-forearm is-far" d="M-13.8 -84L-12.5 -66"></path>
        <path class="op-torso" d="M-13 -104Q-13 -113-5 -113H5Q13 -113 13 -104L11 -55Q11 -51 7 -51H-7Q-11 -51-11 -55Z"></path>
        <path class="op-collar" d="M-5 -113L0 -106L5 -113Z"></path>
        <g class="op-arm xlive">
          <path class="op-sleeve" d="M9 -105L19 -88"></path>
          <path class="op-forearm" d="M20 -87L37 -89"></path>
          <circle class="op-hand" cx="40" cy="-89" r="4.2"></circle>
          <rect class="op-band" x="27" y="-93.5" width="6.5" height="9" rx="2"></rect>
          <circle class="op-dot" cx="30.2" cy="-89" r="1.7"></circle>
          <circle class="op-pulse xlive" cx="30.2" cy="-89" r="5"></circle>
        </g>
        <circle class="op-dot" cx="14.5" cy="-97" r="1.7"></circle>
        <circle class="op-pulse xlive is-late" cx="14.5" cy="-97" r="5"></circle>
        <rect class="op-neck" x="-3" y="-119" width="6" height="8"></rect>
        <circle class="op-head" cx="0" cy="-127" r="11"></circle>
        <path class="op-hair" d="M-11.6 -121Q-14 -140.5 0 -140.5Q14 -140.5 11.6 -121Q11.4 -117 9.6 -115.5Q10.6 -128 3 -131.5Q-5.5 -132.5-8.8 -125Q-9.8 -120-9.4 -115.5Q-11.4 -117-11.6 -121Z"></path>
      </g>
    </svg>
    </div>

    <div class="ses-tabs">
      {
        parts.map((part, i) => (
          <label class="ses-tab" for={`${id}-a${i + 1}`} data-pick-a={i + 1}>
            <span class="ses-tab-name">
              <span class="xlong">{part.name}</span>
              <span class="xshort" aria-hidden="true">
                {part.short}
              </span>
            </span>
            <span class="ses-tab-sub xlong">{part.sub}</span>
          </label>
        ))
      }
    </div>

    <div class="xscreen ses-rec">
      <span class="ses-band" aria-hidden="true"></span>

      <div class="ses-lane">
        <p class="ses-ch">
          <span class="ses-led-dot is-glow"></span>Wearable physiology
          <span class="ses-ch-sub xlong">heart-rate variability, skin conductance, skin temperature</span>
        </p>
        <div class="ses-track">
          {
            parts.map((_, i) => (
              <span class="ses-cell" data-a={i + 1}>
                {i < 4 && (
                  <svg viewBox={`0 0 ${WAVE.width} ${WAVE.height}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
                    <path class="ses-wave" d={waveFor(i)} />
                    <path class="ses-wave-head xlive" d={waveFor(i)} pathLength="100" />
                  </svg>
                )}
              </span>
            ))
          }
        </div>
      </div>

      <div class="ses-lane">
        <p class="ses-ch"><span class="ses-led-dot is-mint"></span>Station timing and errors</p>
        <div class="ses-track">
          {
            parts.map((_, i) => (
              <span class="ses-cell" data-a={i + 1}>
                {isStation(i) && <span class="ses-timer" />}
                {i === 4 && (
                  <span class="ses-chip">
                    <span class="xlong">Function check</span>
                    <span class="xshort" aria-hidden="true">
                      Check
                    </span>
                  </span>
                )}
              </span>
            ))
          }
        </div>
      </div>

      <div class="ses-lane">
        <p class="ses-ch"><span class="ses-led-dot is-paper"></span>Self-report</p>
        <div class="ses-track">
          {
            parts.map((_, i) => (
              <span class="ses-cell" data-a={i + 1}>
                {isStation(i) && <span class="ses-report" />}
                {i === 4 && (
                  <span class="ses-chip">
                    <span class="xlong">NASA-TLX</span>
                    <span class="xshort" aria-hidden="true">
                      TLX
                    </span>
                  </span>
                )}
              </span>
            ))
          }
        </div>
      </div>

      <p class="ses-breaks xlong" aria-hidden="true">
        <span style="left:40%">5-minute break</span>
        <span style="left:60%">5-minute break</span>
      </p>
    </div>

    <div class="ses-readouts">
      <div class="xcard ses-now">
        <div class="xpanes" aria-live="polite">
        {
          parts.map((part, i) => (
            <div class="xpane" data-a={i + 1}>
              <p class="xlabel">Now</p>
              <p class="xpane-title">{part.title}</p>
              <p>{part.text}</p>
              <p class="ses-vh">Recorded here: {part.recorded.join(', ')}.</p>
            </div>
          ))
        }
        </div>
        <ul class="ses-chan" aria-hidden="true">
          <li data-a="1 2 3 4"><span class="ses-key is-wear"></span>Wearable physiology</li>
          <li data-a="2 3 4 5"><span class="ses-key is-time"></span>Timing and errors</li>
          <li data-a="2 3 4 5"><span class="ses-key is-self"></span>Self-report</li>
        </ul>
      </div>

      <div class="xcard ses-how">
        <div class="xpanes" aria-live="polite">
          <div class="xpane" data-b="1">
            <p class="xlabel">Instructions</p>
            <p class="xpane-title">Paper</p>
            <p>Printed diagrams and written steps at each station.</p>
          </div>
          <div class="xpane" data-b="2">
            <p class="xlabel">Instructions</p>
            <p class="xpane-title">Tablet video</p>
            <p>Step-by-step video on a tablet at each station.</p>
          </div>
        </div>
        <div class="ses-reveal" data-b="2">
          <p class="ses-reveal-title">Completion time with video, compared with paper</p>
          <ul class="ses-results">
            <li>
              <svg viewBox="0 0 64 34" aria-hidden="true" focusable="false">
                <path class="ses-slope" d="M8 8L56 25"></path>
                <circle class="ses-from" cx="8" cy="8" r="3.4"></circle>
                <circle class="ses-to" cx="56" cy="25" r="4.4"></circle>
              </svg>
              <span>
                <span class="ses-who">Novice operator</span>
                <span class="ses-what is-down">Shorter</span>
              </span>
            </li>
            <li>
              <svg viewBox="0 0 64 34" aria-hidden="true" focusable="false">
                <path class="ses-slope" d="M8 16L56 17"></path>
                <circle class="ses-from" cx="8" cy="16" r="3.4"></circle>
                <circle class="ses-to" cx="56" cy="17" r="4.4"></circle>
              </svg>
              <span>
                <span class="ses-who">Experienced operator</span>
                <span class="ses-what">Little change</span>
              </span>
            </li>
          </ul>
          <p class="ses-scale">The lines show direction only. They are not to scale.</p>
          <p class="ses-nudge" aria-hidden="true">Switch to tablet video to see what changed</p>
        </div>
      </div>
    </div>
  </div>

  <Fragment slot="caption">
    Drawn for this site from the study design in the Proceedings of the IISE Annual Conference &amp; Expo 2025. The
    two glowing points on the operator stand for the wearables, an Empatica E4 and an EmotiBit. The wave marks when
    they record and is not study data. This was a feasibility study, so the result is not a general finding.
  </Fragment>
</XFigure>
