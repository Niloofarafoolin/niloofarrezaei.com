---
/**
 * Manufacturing Letters 2025: the paper's illustrative example, as something to try.
 * One factor, operator learning, moves KPIs in the operational, environmental and social layers.
 *
 * Every statement comes from the published paper. The paper gives the direction of each
 * effect and no measured values, so the column heights are illustrative and the caption says so.
 *
 * The stack is drawn here in isometric view: x and y run across a layer, z runs up.
 */
import XFigure from './XFigure.astro';

const id = 'fig-layers';

// Five moments on the paper's learning curve, L(t) = L0 + (Lmax − L0)(1 − e^(−λt)).
const skill = [0, 0.5, 0.75, 0.88, 0.96];
const LAMBDA = 0.7;
const T_MAX = 4.9;

// ---------- the learning curve ----------

const BOX = { x0: 34, x1: 346, y0: 168, y1: 22 };
const cx = (t: number) => BOX.x0 + (t / T_MAX) * (BOX.x1 - BOX.x0);
const cy = (s: number) => BOX.y0 - s * (BOX.y0 - BOX.y1);
const curvePts = Array.from({ length: 61 }, (_, i) => {
  const t = (i / 60) * T_MAX;
  return `${cx(t).toFixed(1)} ${cy(1 - Math.exp(-LAMBDA * t)).toFixed(1)}`;
});
const curve = 'M' + curvePts.join('L');
const area = `${curve}L${BOX.x1} ${BOX.y0}L${BOX.x0} ${BOX.y0}Z`;
const stops = skill.map((s) => ({ x: cx(-Math.log(1 - s) / LAMBDA), y: cy(s) }));

// ---------- the stack ----------

const S = 21;
const C = Math.cos(Math.PI / 6);
const OX = 232;
const OY = 42;
const W = 6;
const T = 0.3;
/** Far enough apart that a column on one layer clears the layer above it. */
const GAP = 5.9;
const A = 1.15;
type P3 = [number, number, number];
const iso = ([x, y, z]: P3) => [OX + (x - y) * C * S, OY + (x + y) * 0.5 * S - z * S];
const d = (pts: P3[]) => 'M' + pts.map((p) => iso(p).map((v) => v.toFixed(1)).join(' ')).join('L') + 'Z';

const layers = [
  { key: 'op', name: 'Operational', kpis: [{ name: 'Cycle time', x: 3.12, y: 3.12, h: 2.6, drop: 40, up: 0 }] },
  { key: 'env', name: 'Environmental', kpis: [{ name: 'Energy use', x: 3.12, y: 3.12, h: 2.3, drop: 30, up: 0 }] },
  {
    key: 'soc',
    name: 'Social',
    kpis: [
      { name: 'Fatigue', x: 1.42, y: 4.82, h: 2.2, drop: 42, up: 0 },
      { name: 'Cognitive load', x: 3.12, y: 3.12, h: 2.6, drop: 46, up: 0 },
      { name: 'Ergonomic risk', x: 4.82, y: 1.42, h: 2.0, drop: 34, up: 0 },
    ],
  },
].map((layer, k) => {
  const z = -k * GAP;
  return {
    ...layer,
    z,
    top: d([[0, 0, z], [W, 0, z], [W, W, z], [0, W, z]]),
    left: d([[0, W, z], [W, W, z], [W, W, z - T], [0, W, z - T]]),
    right: d([[W, 0, z], [W, W, z], [W, W, z - T], [W, 0, z - T]]),
    grid: [1.5, 3, 4.5]
      .flatMap((g) => [
        `M${iso([g, 0, z]).map((v) => v.toFixed(1)).join(' ')}L${iso([g, W, z]).map((v) => v.toFixed(1)).join(' ')}`,
        `M${iso([0, g, z]).map((v) => v.toFixed(1)).join(' ')}L${iso([W, g, z]).map((v) => v.toFixed(1)).join(' ')}`,
      ])
      .join(''),
    label: iso([0, W, z]),
    kpis: layer.kpis.map((kpi, i) => {
      const { x, y, h } = kpi;
      const clip = [iso([x, y + A, z]), iso([x + A, y + A, z]), iso([x + A, y, z])];
      const head = iso([x + A / 2, y + A / 2, z + h]);
      return {
        ...kpi,
        clipId: `lay-clip-${k}-${i}`,
        clip: `M${clip.map((p) => p.map((v) => v.toFixed(1)).join(' ')).join('L')}L${clip[2][0].toFixed(1)} 0L${clip[0][0].toFixed(1)} 0Z`,
        topFace: d([[x, y, z + h], [x + A, y, z + h], [x + A, y + A, z + h], [x, y + A, z + h]]),
        leftFace: d([[x, y + A, z], [x + A, y + A, z], [x + A, y + A, z + h], [x, y + A, z + h]]),
        rightFace: d([[x + A, y, z], [x + A, y + A, z], [x + A, y + A, z + h], [x + A, y, z + h]]),
        foot: d([[x, y, z], [x + A, y, z], [x + A, y + A, z], [x, y + A, z]]),
        sink: (h * S).toFixed(1),
        head,
        labelY: k > 0 && Math.abs(x - y) < 0.01 ? iso([x + A, y + A, z])[1] + 15 : head[1] - A * 0.5 * S - 7,
      };
    }),
  };
});

// The cascade: from under one layer to the top of the column on the next.
const links = [0, 1].map((k) => {
  const mid = 3.12 + A / 2;
  const from = iso([mid, mid, layers[k].z - T]);
  const to = iso([mid, mid, layers[k + 1].z + layers[k + 1].kpis[layers[k + 1].kpis.length > 1 ? 1 : 0].h + 0.45]);
  return `M${from[0].toFixed(1)} ${(from[1] + 3).toFixed(1)}V${to[1].toFixed(1)}`;
});
const posts = [
  [0, W],
  [W, 0],
].map(([x, y]) => {
  const a = iso([x, y, 0]);
  const b = iso([x, y, -2 * GAP]);
  return `M${a[0].toFixed(1)} ${a[1].toFixed(1)}V${b[1].toFixed(1)}`;
});

const relations = [
  { key: 'ind', name: 'Independent', text: 'Two KPIs that do not directly influence each other.', example: 'Production output and workforce diversity.' },
  { key: 'dep', name: 'Dependent', text: 'A change in one drives a change in the other.', example: 'Rising customer demand raises production speed.' },
  { key: 'con', name: 'Conflict', text: 'A gain in one comes at the expense of the other.', example: 'Cutting costs can lower employee satisfaction.' },
  { key: 'com', name: 'Compound', text: 'Improvements that complement and amplify each other.', example: 'Automation and training together lift efficiency more than either alone.' },
];

// Where the marker sits, and how far the columns sink, for each choice.
const stateCss = skill
  .map(
    (s, i) =>
      `.fig-layers .xin-a[value="${i + 1}"]:checked ~ .xfig-stage{--skill:${s};--mx:${stops[i].x.toFixed(1)}px;--my:${stops[i].y.toFixed(1)}px}`,
  )
  .join('');
---

<XFigure
  id={id}
  no={4}
  title="One change, three layers"
  hint="Move the operator along the learning curve and watch all three layers respond."
>
  {
    skill.map((_, i) => (
      <input class="xin xin-a" type="radio" name={`${id}-a`} id={`${id}-a${i + 1}`} value={i + 1} checked={i === 0} />
    ))
  }
  <style is:inline set:html={stateCss}></style>

  <div class="xfig-stage lay">
    <div class="xcard lay-curve">
      <p class="xlabel">The paper’s learning curve</p>
      <p class="lay-curve-title">Operator skill, over time on the line</p>
      <svg class="lay-chart" viewBox="0 0 360 190" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="lay-area" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8d3514" stop-opacity="0.26"></stop>
            <stop offset="1" stop-color="#8d3514" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <path class="lay-gridline" d="M34 22H346M34 70.7H346M34 119.3H346"></path>
        <path class="lay-area" d={area}></path>
        <path class="lay-axis" d="M34 14V168H352"></path>
        <path class="lay-line" d={curve}></path>
        <g class="lay-marker">
          <path class="lay-guide" d="M0 0V200M0 0H-400"></path>
          <circle class="lay-halo xlive" r="9"></circle>
          <circle class="lay-dot" r="6.5"></circle>
        </g>
      </svg>
      <div class="lay-slider">
        <span class="lay-end">New hire</span>
        <div class="lay-stops">
          {
            skill.map((_, i) => (
              <label class:list={['lay-stop', i === 1 && 'xnudge']} for={`${id}-a${i + 1}`} data-pick-a={i + 1}>
                <span class="lay-vh">Skill level {i + 1} of 5</span>
              </label>
            ))
          }
        </div>
        <span class="lay-end">Experienced</span>
      </div>
      <p class="lay-note">
        As skill grows, cycle time, energy use, fatigue, cognitive load and ergonomic risk all fall. The paper calls
        this a compound effect.
      </p>
    </div>

    <div class="lay-stack" aria-hidden="true">
      <svg viewBox="4 0 350 446" focusable="false">
        <defs>
          {layers.flatMap((layer) => layer.kpis.map((kpi) => <clipPath id={kpi.clipId}><path d={kpi.clip} /></clipPath>))}
        </defs>
        {posts.map((p) => <path class="lay-post" d={p} />)}
        {
          [...layers].reverse().map((layer) => (
            <g class:list={['lay-layer', `is-${layer.key}`]}>
              <path class="lay-slab-l" d={layer.left} />
              <path class="lay-slab-r" d={layer.right} />
              <path class="lay-slab-t" d={layer.top} />
              <path class="lay-slab-grid" d={layer.grid} />
              {layer.kpis.map((kpi) => <path class="lay-foot" d={kpi.foot} />)}
              {layer.kpis.map((kpi) => (
                <g clip-path={`url(#${kpi.clipId})`}>
                  <g class="lay-col" style={`--drop:${kpi.drop};--sink:${kpi.sink}`}>
                    <path class="lay-col-l" d={kpi.leftFace} />
                    <path class="lay-col-r" d={kpi.rightFace} />
                    <path class="lay-col-t" d={kpi.topFace} />
                  </g>
                </g>
              ))}
              {layer.kpis.map((kpi) => <path class="lay-ghost" d={kpi.topFace} />)}
              <text class="lay-name" x={(layer.label[0] - 12).toFixed(1)} y={(layer.label[1] - 2).toFixed(1)} text-anchor="end">
                {layer.name}
              </text>
              <text class="lay-name-sub" x={(layer.label[0] - 12).toFixed(1)} y={(layer.label[1] + 12).toFixed(1)} text-anchor="end">
                layer
              </text>
            </g>
          ))
        }
        {links.map((link) => <path class="lay-link xlive" d={link} />)}
        {
          layers.flatMap((layer) =>
            layer.kpis.map((kpi) => (
              <text class="lay-kpi" x={kpi.head[0].toFixed(1)} y={kpi.labelY.toFixed(1)} text-anchor="middle">
                {kpi.name}
              </text>
            )),
          )
        }
      </svg>
    </div>

    <div class="lay-relations">
      <p class="xlabel">The paper names four ways KPIs relate</p>
      <ul class="lay-rel">
        {
          relations.map((relation) => (
            <li>
              <span class:list={['lay-glyph', `is-${relation.key}`]} aria-hidden="true">
                <i class="xlive" />
                <i class="xlive" />
                {relation.key === 'com' && <i class="xlive" />}
              </span>
              <b>{relation.name}</b>
              <span>{relation.text}</span>
              <span class="lay-example">{relation.example}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <Fragment slot="caption">
    The published framework my dissertation builds on. Drawn for this site from the illustrative example in
    Heydarzade, Rezaei, Vaezi &amp; Camelio (2025), Manufacturing Letters 44. The paper gives the direction of each
    effect. The column heights are illustrative, not data, and the dashed outlines mark where each column started.
  </Fragment>
</XFigure>
