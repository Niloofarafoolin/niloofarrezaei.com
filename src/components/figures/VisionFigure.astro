---
/**
 * Manufacturing Letters 2024: the proposed two-camera framework, shown as two camera
 * feeds, the state estimated from them, and the responses on the line.
 *
 * Every statement comes from the published paper. The paper proposes this framework and
 * does not report a validation study, and the caption says so. The feeds are drawings in
 * a single tone, like an infrared view. They show no real person, and the meters show no values.
 */
import XFigure from './XFigure.astro';
import { type Pt, line, faceLines, facePoints, corners } from '../../lib/face-marks';

const id = 'fig-vision';

const steps = [
  {
    name: 'See',
    title: 'See: two video streams',
    text: 'Two connected cameras at the station send time-stamped video. One films the operator’s face, the other the body posture.',
  },
  {
    name: 'Read',
    title: 'Read: features from each frame',
    text: 'Facial action units and body keypoints are extracted from the frames, or a vision model reads the frames directly.',
  },
  {
    name: 'Assess',
    title: 'Assess: the operator’s state',
    text: 'An inference step estimates fatigue, cognitive load and stress, and relates them to productivity and error rates.',
  },
  {
    name: 'Respond',
    title: 'Respond: on the line',
    text: 'Proposed responses: adjust workstation ergonomics, send real-time alerts, and use long-term trends to plan breaks, balance the line, revise procedures and improve training.',
  },
];

const views = [
  { name: 'Clear view', note: 'Both views are available. The reading draws on face and posture together.' },
  { name: 'Face hidden', note: 'The face view falls short. The posture view keeps the reading going.' },
  { name: 'Body hidden', note: 'The posture view falls short. The face view keeps the reading going.' },
];

// Keypoints of the drawn body.
const J = {
  head: [160, 58] as Pt,
  neck: [160, 90] as Pt,
  shL: [122, 100] as Pt,
  shR: [198, 100] as Pt,
  elL: [103, 142] as Pt,
  elR: [217, 142] as Pt,
  wrL: [129, 171] as Pt,
  wrR: [191, 171] as Pt,
  mid: [160, 134] as Pt,
  hip: [160, 176] as Pt,
};
const bodyLines = [
  line([J.head, J.neck, J.mid, J.hip]),
  line([J.shL, J.neck, J.shR]),
  line([J.shL, J.elL, J.wrL]),
  line([J.shR, J.elR, J.wrR]),
];
const bodyPoints = Object.values(J);

---

<XFigure
  id={id}
  no={3}
  title="Two camera views, one reading of the operator"
  hint="Step through the framework. Then hide one view to see why it uses two."
>
  {
    steps.map((_, i) => (
      <input class="xin xin-a" type="radio" name={`${id}-a`} id={`${id}-a${i + 1}`} value={i + 1} checked={i === 0} />
    ))
  }
  {
    views.map((_, i) => (
      <input class="xin xin-b" type="radio" name={`${id}-b`} id={`${id}-b${i + 1}`} value={i + 1} checked={i === 0} />
    ))
  }

  <div class="vis-controls">
    <div class="xsteps" style="--n:4">
      {
        steps.map((step, i) => (
          <label
            class:list={['xstep', i === 1 && 'xnudge']}
            for={`${id}-a${i + 1}`}
            data-pick-a={i + 1}
            data-a={steps.map((_, k) => k + 1).filter((k) => k >= i + 1).join(' ')}
          >
            <span class="xstep-no">{i + 1}</span>
            <span class="xstep-name">{step.name}</span>
          </label>
        ))
      }
    </div>
    <div class="xrow">
      <span class="xlabel">Camera view</span>
      <div class="xseg">
        {
          views.map((view, i) => (
            <label class="xpick" for={`${id}-b${i + 1}`} data-pick-b={i + 1}>
              {view.name}
            </label>
          ))
        }
      </div>
    </div>
  </div>

  <div class="xfig-stage vis">
    <div class="vis-board">
      <div class="xscreen vis-feed" aria-hidden="true">
        <svg viewBox="0 0 320 230" focusable="false">
          <defs>
            <radialGradient id="vis-bg" cx="50%" cy="36%" r="80%">
              <stop offset="0" stop-color="#33413b"></stop>
              <stop offset="1" stop-color="#121815"></stop>
            </radialGradient>
            <linearGradient id="vis-tone" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#a9c0b5"></stop>
              <stop offset="1" stop-color="#718c80"></stop>
            </linearGradient>
            <pattern id="vis-hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(38)">
              <rect width="9" height="9" fill="#17130f"></rect>
              <rect width="3" height="9" fill="#2c231b"></rect>
            </pattern>
          </defs>
          <rect width="320" height="230" fill="url(#vis-bg)"></rect>
          <path d="M48 230Q54 180 120 167H200Q266 180 272 230Z" fill="#4a6055"></path>
          <path d="M140 148H180V170Q160 187 140 170Z" fill="#86a295"></path>
          <ellipse cx="119" cy="113" rx="5.5" ry="9.5" fill="#7b968a"></ellipse>
          <ellipse cx="201" cy="113" rx="5.5" ry="9.5" fill="#7b968a"></ellipse>
          <ellipse cx="160" cy="108" rx="40" ry="50" fill="url(#vis-tone)"></ellipse>
          <path d="M119 106Q110 50 160 50Q210 50 201 106Q199 80 181 73Q151 65 133 80Q121 90 119 106Z" fill="#232c28"></path>
          <path class="vis-feature" d="M137 101q6-5 12 0M171 101q6-5 12 0M152 123q8 5 16 0M149 138q11 6 22 0"></path>

          <g class="vis-marks is-face" data-a="2 3 4" data-b="1 3">
            <path class="vis-frame" d={corners(106, 42, 214, 168)}></path>
            {faceLines.map((d) => <path class="vis-mesh" d={d} pathLength="1" />)}
            {facePoints.map(([x, y]) => <circle cx={x} cy={y} r="1.9" />)}
            <text class="vis-tag" x="107" y="35">FACIAL ACTION UNITS</text>
          </g>

          <rect class="vis-scan xlive" x="0" y="0" width="320" height="26"></rect>
          <g class="vis-hud">
            <circle class="vis-rec xlive" cx="14" cy="15" r="4"></circle>
            <text x="24" y="18.2">FACE CAMERA</text>
            <text x="306" y="18.2" text-anchor="end">TIME-STAMPED</text>
          </g>

          <g class="vis-blocked" data-b="2">
            <rect x="34" y="34" width="252" height="162" rx="6" fill="url(#vis-hatch)"></rect>
            <rect class="vis-blocked-edge" x="34" y="34" width="252" height="162" rx="6"></rect>
            <text x="160" y="120" text-anchor="middle">VIEW BLOCKED</text>
          </g>
        </svg>
      </div>

      <div class="xscreen vis-feed" aria-hidden="true">
        <svg viewBox="0 0 320 230" focusable="false">
          <rect width="320" height="230" fill="url(#vis-bg)"></rect>
          <path d="M118 104Q118 90 134 90H186Q202 90 202 104L193 178H127Z" fill="#587166"></path>
          <path d="M122 100L103 142L129 171" class="vis-arm"></path>
          <path d="M198 100L217 142L191 171" class="vis-arm"></path>
          <rect x="151" y="78" width="18" height="16" fill="#86a295"></rect>
          <ellipse cx="160" cy="58" rx="20" ry="24" fill="url(#vis-tone)"></ellipse>
          <path d="M140 56Q136 30 160 30Q184 30 180 56Q178 44 168 41Q152 38 144 46Q140 50 140 56Z" fill="#232c28"></path>
          <rect x="22" y="176" width="276" height="11" rx="3" fill="#3b4c44"></rect>
          <rect x="22" y="187" width="276" height="43" fill="#1b2420"></rect>
          <rect x="140" y="163" width="16" height="13" rx="2" fill="#8fa89c"></rect>
          <rect x="160" y="158" width="18" height="18" rx="2" fill="#a9c0b5"></rect>
          <rect x="62" y="166" width="26" height="10" rx="2" fill="#4a6055"></rect>
          <rect x="236" y="162" width="30" height="14" rx="2" fill="#4a6055"></rect>

          <g class="vis-marks is-body" data-a="2 3 4" data-b="1 2">
            <path class="vis-frame" d={corners(84, 24, 236, 190)}></path>
            {bodyLines.map((d) => <path class="vis-mesh" d={d} pathLength="1" />)}
            {bodyPoints.map(([x, y]) => <circle cx={x} cy={y} r="4.2" />)}
            <text class="vis-tag" x="85" y="203">BODY KEYPOINTS</text>
          </g>

          <rect class="vis-scan xlive is-late" x="0" y="0" width="320" height="26"></rect>
          <g class="vis-hud">
            <circle class="vis-rec xlive" cx="14" cy="15" r="4"></circle>
            <text x="24" y="18.2" class="vis-hud-name">POSTURE CAMERA</text>
          </g>

          <g class="vis-blocked" data-b="3">
            <rect x="34" y="34" width="252" height="162" rx="6" fill="url(#vis-hatch)"></rect>
            <rect class="vis-blocked-edge" x="34" y="34" width="252" height="162" rx="6"></rect>
            <text x="160" y="120" text-anchor="middle">VIEW BLOCKED</text>
          </g>
        </svg>
      </div>

      <div class="xscreen vis-state" data-a="3 4">
        <p class="vis-ch"><span class="vis-badge">3</span>Estimated state</p>
        <ul class="vis-meters">
          <li><span>Fatigue</span><span class="vis-meter"><i class="xlive"></i></span></li>
          <li><span>Cognitive load</span><span class="vis-meter"><i class="xlive is-b"></i></span></li>
          <li><span>Stress</span><span class="vis-meter"><i class="xlive is-c"></i></span></li>
        </ul>
        <ul class="vis-src">
          <li data-b="1 3"><span class="vis-light is-face"></span>face cues</li>
          <li data-b="1 2"><span class="vis-light is-body"></span>posture cues</li>
        </ul>
        <p class="vis-rel">Related to productivity and error rates. The meters show no values.</p>
      </div>
    </div>

    <ul class="vis-resp">
      <li data-a="4">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <path d="M4 14h24M7 14v12M25 14v12M16 3v7M12.5 6.5L16 3l3.5 3.5M12.5 22.5L16 26l3.5-3.5M16 26v-7"></path>
        </svg>
        <span><b>Adjust the workstation</b>Ergonomics change with the assessment.</span>
      </li>
      <li data-a="4">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <path d="M9 22V14a7 7 0 0114 0v8l2.5 3h-19zM13.5 27.5a2.6 2.6 0 005 0M16 4v3"></path>
        </svg>
        <span><b>Alert in real time</b>A notification prompts immediate help.</span>
      </li>
      <li data-a="4">
        <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <path d="M4 27h24M6 22l6-7 5 4 9-11M21 8h5v5"></path>
        </svg>
        <span><b>Plan with long-term trends</b>Breaks, line balance, procedures, training.</span>
      </li>
    </ul>

    <div class="vis-words">
      <div class="xcard xpanes" aria-live="polite">
        {
          steps.map((step, i) => (
            <div class="xpane" data-a={i + 1}>
              <p class="xlabel">Step {i + 1} of 4</p>
              <p class="xpane-title">{step.title}</p>
              <p>{step.text}</p>
            </div>
          ))
        }
      </div>
      <div class="xcard">
        <p class="xlabel">Why two views</p>
        <div class="xpanes" aria-live="polite">
          {
            views.map((view, i) => (
              <p class="xpane vis-note" data-b={i + 1}>
                {view.note}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <Fragment slot="caption">
    A proposed framework, not a validated system. The paper argues that combining methods keeps the reading robust
    when one falls short through occlusion, lighting or noise. The camera views are drawings, not footage. Drawn for
    this site from Rezaei, Vaezi &amp; Camelio (2024), Manufacturing Letters 41.
  </Fragment>
</XFigure>
