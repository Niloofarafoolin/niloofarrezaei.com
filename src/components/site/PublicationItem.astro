---
import StatusLabel from './StatusLabel.astro';
import FigureThumb from '../figures/FigureThumb.astro';
import type { Publication } from '../../data/publications';

interface Props {
  item: Publication;
  /** Home page version: takeaway first, shorter citation. */
  brief?: boolean;
}

const { item, brief = false } = Astro.props;
const last = item.authors.length - 1;
---

<li class:list={['pub', brief && 'is-brief']}>
  <p class="pub-year">{item.year ?? 'In review'}</p>
  <div class="pub-body">
    <h3 class="pub-title">{item.title}</h3>
    <p class="pub-takeaway">{item.takeaway}</p>
    <p class="pub-cite">
      {
        item.authors.map((author, i) => (
          <>
            {author.me ? <strong class="me">{author.name}</strong> : <span>{author.name}</span>}
            {i < last - 1 ? ', ' : i === last - 1 ? ', & ' : ' '}
          </>
        ))
      }
      {item.year && <span>({item.year}). </span>}
      <cite>{item.venue}</cite>{item.detail ? `, ${item.detail}` : '.'}
    </p>
    <p class="pub-meta">
      <StatusLabel status={item.status} />
      <span class="tag">{item.role}</span>
      {item.openAccess && <span class="tag tag-open">Open access</span>}
      {
        item.doi && (
          <a href={`https://doi.org/${item.doi}`} rel="noopener">
            doi:{item.doi}
          </a>
        )
      }
      {
        item.links?.map((link) => (
          <a href={link.href} rel="noopener">
            {link.label}
          </a>
        ))
      }
      {item.project && <a href={`/research#${item.project}`}>Project</a>}
    </p>
    {
      !brief && item.bibtex && (
        <details class="pub-bib">
          <summary>Cite (BibTeX)</summary>
          <pre id={`cite-${item.id}`}><code>{item.bibtex}</code></pre>
        </details>
      )
    }
  </div>
  {item.figure && <FigureThumb figure={item.figure} />}
</li>
