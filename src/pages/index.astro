---
import SiteLayout from '../layouts/SiteLayout.astro';
import SystemFigure from '../components/figures/SystemFigure.astro';
import '../styles/figures.css';
import StatusLabel from '../components/site/StatusLabel.astro';
import QuestionArt from '../components/site/QuestionArt.astro';
import PublicationItem from '../components/site/PublicationItem.astro';
import Portrait from '../components/site/Portrait.astro';
import Recognition from '../components/site/Recognition.astro';
import { person, thesis, jobMarket, thrusts, recognition } from '../data/program';
import { publications } from '../data/publications';
import { teaching } from '../data/teaching';
import { presentations } from '../data/cv';

// First-author work leads on the home page; the Publications page keeps the CV's order.
const isFirstAuthor = (role: string) => Number(role.startsWith('First'));
const selected = publications
  .filter((item) => item.selected)
  .sort((x, y) => isFirstAuthor(y.role) - isFirstAuthor(x.role) || (y.year ?? 0) - (x.year ?? 0));
const talks = presentations.slice(0, 3);
// The two competition wins, named beside the portrait on the first screen.
const wins = recognition.filter((item) => item.short);
---

<SiteLayout
  title={`${person.name} · Human-centered smart manufacturing`}
  description={`${thesis.statement} ${thesis.turn} ${person.role}, ${person.university}.`}
  isHome
  profile
>
  <section class="hero" aria-label="Introduction">
    <div class="wrap">
      <div class="hero-bar">
        <div class="identity">
          <Portrait variant="chip" />
          <div class="identity-text">
            <p class="eyebrow">
              <span>{person.role}</span>
              <span>{person.university}</span>
            </p>
            <a class="award-line" href="#recognition">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="9" r="5.2"></circle>
                <path d="M8.6 13.2L7 21l5-2.6L17 21l-1.6-7.8"></path>
              </svg>
              <b>{wins[0].kind}, {wins[0].year}:</b>{' '}
              <span>{wins.map((item) => item.short).join(' · ')}</span>
            </a>
          </div>
        </div>
        {
          jobMarket.show && (
            <p class="job-note">
              <span class="tag">{jobMarket.label}</span>
              <span>{jobMarket.text}</span>
            </p>
          )
        }
      </div>

      <div class="hero-top">
        <div class="hero-lead">
          <p class="thesis">
            {thesis.statement}
            <span class="thesis-turn">{thesis.turn}</span>
          </p>
        </div>
        <div class="hero-side">
          <p class="lede">{thesis.lede}</p>
          <div class="actions">
            <a class="btn btn-primary" href="/research">Research</a>
            <a class="btn" href="/cv">CV</a>
            <a class="email" href={`mailto:${person.email}`}>{person.email}</a>
          </div>
        </div>
      </div>

      <SystemFigure />

      <dl class="facts">
        <div>
          <dt>Why it matters</dt>
          <dd>{thesis.why}</dd>
        </div>
        <div>
          <dt>How I study it</dt>
          <dd>{thesis.how}</dd>
        </div>
      </dl>
    </div>
  </section>

  <Recognition />

  <section class="section" aria-labelledby="questions-heading">
    <div class="wrap">
      <p class="section-label">Research program</p>
      <h2 class="section-title" id="questions-heading">Three open questions</h2>
      <p class="section-intro">Each one is a thrust of the research agenda I will pursue as faculty.</p>

      <ol class="qcards">
        {
          thrusts.map((thrust, i) => (
            <li class="qcard">
              <div class="qcard-art">
                <QuestionArt n={(i + 1) as 1 | 2 | 3} />
              </div>
              <div class="qcard-body">
                <p class="qcard-top">
                  <span class="q-no" aria-hidden="true">
                    {thrust.number}
                  </span>
                  <StatusLabel status={thrust.status} />
                </p>
                <h3 class="q-text">{thrust.question}</h3>
                <p class="q-thrust">{thrust.title}</p>
                <p class="q-first">
                  <span class="tag">First project</span>
                  <span>{thrust.firstProject}</span>
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="more"><a href="/research">Read the full research agenda</a></p>
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="work-heading">
    <div class="wrap">
      <p class="section-label">Evidence so far</p>
      <h2 class="section-title" id="work-heading">Selected publications</h2>
      <ol class="pubs">
        {selected.map((item) => <PublicationItem item={item} brief />)}
      </ol>
      <p class="more"><a href="/publications">All publications</a></p>
    </div>
  </section>

  <section class="band" aria-label="Teaching and talks">
    <div class="wrap duo">
      <div>
        <h2 class="section-label">Teaching and mentoring</h2>
        <p class="duo-lead">{teaching.course.role}: {teaching.course.title}.</p>
        <p class="duo-text">{teaching.mentoring.summary}</p>
        <p class="more"><a href="/teaching">Teaching and mentoring</a></p>
      </div>
      <div>
        <h2 class="section-label">Recent talks</h2>
        <ul class="talks">
          {
            talks.map((talk) => (
              <li>
                <span class="tag">{talk.kind}</span>
                <span class="talk-title">{talk.title}</span>
                <span class="talk-where">
                  {talk.where}, {talk.when}
                </span>
                {talk.link && (
                  <a class="talk-link" href={talk.link.href} rel="noopener">
                    {talk.link.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</SiteLayout>
