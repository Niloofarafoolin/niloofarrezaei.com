---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHead from '../components/site/PageHead.astro';
import { person, jobMarket } from '../data/program';
---

<SiteLayout
  title="Contact"
  description="How to reach Niloofar Rezaei, Ph.D. Candidate in Engineering at the University of Georgia."
>
  <PageHead label="Contact" title="Contact" lede="Email is the best way to reach me." />

  <section class="section section-tight" aria-label="Contact details">
    <div class="wrap split">
      <dl class="glance">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${person.email}`}>{person.email}</a></dd>
        </div>
        <div>
          <dt>Profiles</dt>
          <dd>
            <a href={person.scholar} rel="me noopener">Google Scholar</a>
            <br />
            <a href={person.linkedin} rel="me noopener">LinkedIn</a>
          </dd>
        </div>
        <div>
          <dt>Where</dt>
          <dd>{person.lab}, {person.unit}, {person.university}, Athens, GA</dd>
        </div>
      </dl>

      {
        jobMarket.show && (
          <aside class="aside" aria-labelledby="committee-heading">
            <h2 class="section-label" id="committee-heading">For search committees</h2>
            <p>{jobMarket.text}</p>
            <ul class="plain-list">
              <li><a href="/research">Research agenda and completed work</a></li>
              <li><a href="/publications">Publications</a></li>
              <li><a href="/teaching">Teaching and mentoring</a></li>
              <li><a href="/cv">CV</a></li>
            </ul>
          </aside>
        )
      }
    </div>
  </section>
</SiteLayout>
